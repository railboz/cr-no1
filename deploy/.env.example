# Créno relay — variables du projet Compose (SEULE source de vérité).
#
#   cp deploy/.env.example deploy/.env     # depuis la racine du dépôt
#   docker compose -f deploy/compose.yml up -d --build
#
# Compose charge deploy/.env tout seul (interpolation ${VAR:-défaut} dans
# deploy/compose.yml). deploy/.env n'est jamais versionné (deploy/.gitignore).
# Aucune valeur secrète ici : le relais n'a aucun compte ni jeton à stocker,
# l'URL du calendrier (qui porte le jeton) n'arrive qu'à la requête.
#
# NE PAS copier backend/.env.example dans deploy/.env : ce fichier-là décrit un
# lancement natif (`cargo run`) et fixe l'écoute sur 127.0.0.1, ce qui rendrait
# le conteneur injoignable depuis l'hôte.

# --- Les deux variables que l'on modifie en pratique -------------------------

# Hôtes amont autorisés (suffixes séparés par des virgules, sans schéma ni port).
# Défaut : api.skello.io. C'est ici qu'on ajoute un domaine si l'ICS change.
CRENO_ALLOWED_HOSTS=api.skello.io

# Origines CORS exactes supplémentaires (séparées par des virgules, pas de
# joker). Défaut : vide, c'est-à-dire aucune. À remplir si la page Créno est
# servie depuis un autre domaine que ceux déjà acceptés.
# Exemple : CRENO_ALLOWED_ORIGINS=https://creno.example.fr
CRENO_ALLOWED_ORIGINS=

# --- Réglages à toucher rarement ---------------------------------------------

# Taille maximale du corps amont, en octets (2 Mio ; bornes 1 Kio à 64 Mio).
CRENO_MAX_BYTES=2097152

# Délai amont maximal, en secondes (bornes 1 à 120).
CRENO_TIMEOUT_SECS=12

# Requêtes par minute et par IP (rafale de 10).
CRENO_RATE_LIMIT=30

# 1 = accepter les origines moz-extension:// (extension Firefox).
CRENO_ALLOW_EXTENSION=0

# 1 = accepter l'origine "null" d'une page ouverte en file:// (nécessaire pour
# ouvrir index.html par double-clic, refusée par défaut).
# CRENO_ALLOW_FILE_ORIGIN=0

# info | debug | warn
RUST_LOG=info

# --- Image -------------------------------------------------------------------

# Tag produit par `docker compose build` ; surchargez-le pour publier ou
# épingler une version (ex. registry.example.fr/creno-relay:0.1.0).
CRENO_IMAGE=creno-relay:0.1.0

# CRENO_BIND est volontairement absent : dans le conteneur l'écoute doit rester
# 0.0.0.0:8080 (valeur fixée par deploy/compose.yml et par l'image). La seule
# exposition côté hôte se règle dans `ports:` (127.0.0.1:8080 par défaut).
