# Copy to deploy/.env (untracked) and adjust. docker compose reads it
# automatically from this directory for ${VAR:-default} interpolation.

# Upstream hosts the relay may fetch (comma separated, default api.skello.io).
CRENO_ALLOWED_HOSTS=api.skello.io

# Response size cap in bytes (2 MiB) and upstream timeout in seconds.
CRENO_MAX_BYTES=2097152
CRENO_TIMEOUT_SECS=12

# Requests per minute per client IP (burst 10).
CRENO_RATE_LIMIT=30

# 1 = allow moz-extension:// origins (needed by the Firefox extension).
CRENO_ALLOW_EXTENSION=0

# Extra CORS origins, comma separated, no wildcard. Example:
# CRENO_ALLOWED_ORIGINS=https://creno.example.fr
CRENO_ALLOWED_ORIGINS=

# info | debug | warn
RUST_LOG=info

# Image tag produced by `docker compose build`.
CRENO_IMAGE=creno-relay:0.1.0
