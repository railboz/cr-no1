# Créno relay — configuration par variables d'environnement.
# Copier en .env (non versionné, ex. : cp backend/.env.example deploy/.env) et
# adapter. Aucune valeur secrète ici. Référence : CONTRACT.md.

# Adresse d'écoute. 127.0.0.1:8080 en direct ; 0.0.0.0:8080 dans un conteneur.
CRENO_BIND=127.0.0.1:8080

# Suffixes de domaines autorisés (séparés par des virgules, sans schéma ni port).
CRENO_ALLOWED_HOSTS=api.skello.io

# Taille maximale du corps récupéré en amont (octets) : 1 KiB à 64 MiB.
CRENO_MAX_BYTES=2097152

# Délai maximal de la requête amont, en secondes : 1 à 120.
CRENO_TIMEOUT_SECS=12

# Requêtes par minute et par IP (rafale de 10) : 1 à 100000.
CRENO_RATE_LIMIT=30

# 1 = accepter les origines moz-extension:// (extension Firefox).
CRENO_ALLOW_EXTENSION=0

# Origines exactes supplémentaires, séparées par des virgules,
# par exemple https://creno.example.fr
CRENO_ALLOWED_ORIGINS=

# Verbosité des journaux : info (défaut), debug pour diagnostiquer.
RUST_LOG=info
