# Créno relay — variables pour un lancement NATIF (`cargo run`, sans Docker).
#
# Le binaire ne lit aucun fichier .env : exportez ces variables dans le shell.
#   set -a; . ./backend/.env.example; set +a   # ou export VAR=… une à une
#
# Pour Docker / Compose, n'utilisez PAS ce fichier : la source de vérité est
# ../deploy/.env.example  ->  cp deploy/.env.example deploy/.env
# (Compose lit deploy/.env, et l'écoute dans le conteneur doit rester
# 0.0.0.0:8080 — voir la note sur CRENO_BIND ci-dessous.)
#
# Aucune valeur secrète ici : le relais n'a ni compte ni jeton à stocker.
# Référence : CONTRACT.md.

# Adresse d'écoute — COMMENTÉE À DESSEIN : le défaut du binaire est déjà
# 127.0.0.1:8080 (boucle locale). Décommentez uniquement pour un lancement natif
# exposé volontairement sur le réseau. Dans un conteneur, la valeur doit rester
# 0.0.0.0:8080 : 127.0.0.1 y rendrait le service injoignable depuis l'hôte.
# CRENO_BIND=127.0.0.1:8080

# Hôtes amont autorisés (suffixes séparés par des virgules, sans schéma ni port).
CRENO_ALLOWED_HOSTS=api.skello.io

# Origines CORS exactes supplémentaires (virgules, pas de joker), ex.
# https://creno.example.fr. Vide = aucune origine supplémentaire.
CRENO_ALLOWED_ORIGINS=

# Taille maximale du corps amont, en octets (1 Kio à 64 Mio).
CRENO_MAX_BYTES=2097152

# Délai maximal de la requête amont, en secondes (1 à 120).
CRENO_TIMEOUT_SECS=12

# Requêtes par minute et par IP (rafale de 10) : 1 à 100000.
CRENO_RATE_LIMIT=30

# 1 = accepter les origines moz-extension:// (extension Firefox).
CRENO_ALLOW_EXTENSION=0

# Verbosité des journaux : info (défaut), debug pour diagnostiquer.
RUST_LOG=info
