{
  "manifest_version": 2,
  "name": "Créno — Votre planning, simplement",
  "version": "1.1.1",
  "description": "Planning d'horaires 100 % local : shifts, absences, statistiques et salaire estimé. Synchronisation Skello directe et privée (ICS), sans relais public.",
  "author": "Logan BOZIER",
  "icons": {
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "storage",
    "https://api.skello.io/*"
  ],
  "browser_action": {
    "default_title": "Ouvrir Créno",
    "default_icon": {
      "192": "icons/icon-192.png",
      "512": "icons/icon-512.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_security_policy": "script-src 'self'; object-src 'none';",
  "browser_specific_settings": {
    "gecko": {
      "id": "creno@loganbozier.fr",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
